{
  "description": "Tells Maggie when a session's subagents and teammates start and stop, so the sidebar lists them under the session, and when the session needs the user, finishes a turn, fails or ends, so the voice can say so",
  "hooks": {
    "Notification": [
      { "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-event.sh\"", "timeout": 5 }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-event.sh\"", "timeout": 5 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-event.sh\"", "timeout": 5 }] }
    ],
    "TeammateIdle": [
      { "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-event.sh\"", "timeout": 5 }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-event.sh\"", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-event.sh\"", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-event.sh\"", "timeout": 5 }] }
    ]
  }
}
